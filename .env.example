# =============================================================================
# OpsGuardian Environment Configuration (Template - Safe to Commit)
# Copy to `.env` for local development. NEVER commit `.env` or real keys!
# In production, secrets are loaded via Google Cloud Secret Manager (ADC).
# =============================================================================

# Runtime Mode: "local" (SQLite + local PII/guardrails + mock/live telemetry) or "gcp" (Vertex AI + Cloud DLP + Secret Manager + Firestore + Cloud Trace)
OPSGUARDIAN_ENV=local

# Google GenAI / Vertex AI Selection
# Set GOOGLE_GENAI_USE_VERTEXAI=TRUE to use Vertex AI with ADC (`gcloud auth application-default login`)
# Set GOOGLE_GENAI_USE_VERTEXAI=FALSE to use Google AI Studio with a key loaded via Secret Manager or env
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Optional: Vertex AI Agent Engine resource ID (required only when using VertexAiSessionService / VertexAiMemoryBankService)
VERTEX_AGENT_ENGINE_ID=

# Strategic Model Routing (ADK Flash vs Pro)
OPSGUARDIAN_FAST_MODEL=gemini-2.5-flash
OPSGUARDIAN_REASONING_MODEL=gemini-2.5-pro
OPSGUARDIAN_DYNAMIC_ESCALATION_ENABLED=true

# Persistent Session & Knowledge Storage
# Local default uses SQLite with async driver required by ADK DatabaseSessionService
OPSGUARDIAN_SESSION_BACKEND=sqlite
OPSGUARDIAN_DATABASE_URL=sqlite+aiosqlite:///./data/opsguardian_sessions.db
OPSGUARDIAN_KNOWLEDGE_BACKEND=sqlite
OPSGUARDIAN_KNOWLEDGE_DB_PATH=./data/opsguardian_knowledge.db
# Optional GCP Vertex AI Search Data Store (set when OPSGUARDIAN_KNOWLEDGE_BACKEND=vertex_search)
VERTEX_SEARCH_DATA_STORE_ID=

# History Compaction & Context Caching
OPSGUARDIAN_COMPACTION_INTERVAL=4
OPSGUARDIAN_COMPACTION_OVERLAP=1
OPSGUARDIAN_COMPACTION_TOKEN_THRESHOLD=12000
OPSGUARDIAN_COMPACTION_RETENTION_SIZE=4
OPSGUARDIAN_CONTEXT_CACHE_TTL_SECONDS=1800

# Security, Guardrails & PII Redaction
OPSGUARDIAN_ENABLE_CLOUD_DLP=false
OPSGUARDIAN_ENABLE_MODEL_ARMOR=false
MODEL_ARMOR_TEMPLATE_ID=
OPSGUARDIAN_CHANGE_FREEZE=false

# Observability & Distributed Tracing
OPSGUARDIAN_LOG_LEVEL=INFO
OPSGUARDIAN_ENABLE_CLOUD_TRACE=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_CONSOLE_EXPORT=false

# Secret Manager Secret IDs (values are NEVER stored in code or env templates)
SECRET_NAME_GEMINI_API_KEY=opsguardian-gemini-api-key
SECRET_NAME_PAGERDUTY_TOKEN=opsguardian-pagerduty-token
SECRET_NAME_SLACK_WEBHOOK=opsguardian-slack-webhook

# Local Development Only (leave blank when using Vertex AI ADC or Secret Manager)
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
